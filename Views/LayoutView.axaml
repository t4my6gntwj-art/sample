<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:AvaloniaDiApp.ViewModels"
             x:DataType="vm:LayoutViewModel"
             x:Class="AvaloniaDiApp.Views.LayoutView">
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- ヘッダー領域 -->
        <Border Grid.Row="0" Background="#333333" BorderBrush="Black" BorderThickness="0,0,0,1" Height="60" Padding="15,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="HOME" Width="100" Height="35" 
                        Command="{Binding NavigateToHomeCommand}"
                        Background="#444444" Foreground="White"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="SETTING" Width="100" Height="35" 
                        Command="{Binding NavigateToSettingCommand}"
                        Background="#444444" Foreground="White"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="STATUS" Width="100" Height="35" 
                        Command="{Binding NavigateToStatusCommand}"
                        Background="#444444" Foreground="White"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- メインコンテンツ領域 -->
        <Border Grid.Row="1" Background="White" Padding="20">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>

        <!-- フッター領域 -->
        <Border Grid.Row="2" Background="#e0e0e0" Height="40" Padding="10">
            <TextBlock Text="フッター - © 2024 AvaloniaDiApp" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
