<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AvaloniaDiApp.Views.Controls.EmbossButton">

    <!-- 
        【Avalonia 11 徹底ガード】
        TargetType を Button に絞り、標準テンプレート（PART_ContentPresenter等）を完全に差し替えます。
    -->

    <!-- 基本となるコントロール・テンプレート -->
    <ControlTemplate x:Key="EmbossControlTemplate" TargetType="Button">
        <Grid>
            <!-- 本体背景：標準テーマの上書きを遮断するため、直接バインド -->
            <Border Name="PART_InternalBorder" 
                    Background="{TemplateBinding Background}" 
                    CornerRadius="1" />

            <!-- ベベル（影）レイヤー -->
            <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto" 
                  IsHitTestVisible="False"
                  Margin="0">
                <!-- Top -->
                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding (controls:Emboss.TopBrush)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="0" Grid.Column="0" Points="0,0 10,0 10,10" Fill="{TemplateBinding (controls:Emboss.TopBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="0" Grid.Column="2" Points="0,0 10,0 0,10" Fill="{TemplateBinding (controls:Emboss.TopBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>

                <!-- Bottom -->
                <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding (controls:Emboss.BottomBrush)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="2" Grid.Column="0" Points="0,10 10,10 10,0" Fill="{TemplateBinding (controls:Emboss.BottomBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="2" Grid.Column="2" Points="0,10 10,10 0,0" Fill="{TemplateBinding (controls:Emboss.BottomBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>

                <!-- Left -->
                <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding (controls:Emboss.LeftBrush)}" Width="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="0" Grid.Column="0" Points="0,0 0,10 10,10" Fill="{TemplateBinding (controls:Emboss.LeftBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="2" Grid.Column="0" Points="0,0 0,10 10,0" Fill="{TemplateBinding (controls:Emboss.LeftBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>

                <!-- Right -->
                <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding (controls:Emboss.RightBrush)}" Width="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="0" Grid.Column="2" Points="10,0 10,10 0,10" Fill="{TemplateBinding (controls:Emboss.RightBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
                <Polygon Grid.Row="2" Grid.Column="2" Points="0,0 10,0 10,10" Fill="{TemplateBinding (controls:Emboss.RightBrush)}" Stretch="Fill" 
                         Width="{TemplateBinding (controls:Emboss.BevelWidth)}" Height="{TemplateBinding (controls:Emboss.BevelWidth)}"/>
            </Grid>

            <!-- 
                コンテンツ：標準の PART_ContentPresenter を名前を変えて回避。
            -->
            <ContentPresenter Name="PART_EmbossContentPresenter"
                              Content="{TemplateBinding (controls:Emboss.DisplayContent)}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Background="Transparent"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
    </ControlTemplate>

    <!-- ボタンテーマ -->
    <ControlTheme x:Key="EmbossButtonTheme" TargetType="Button">
        <!-- 【重要】テーマそのものに起動スイッチと初期ステータスを持たせます -->
        <Setter Property="controls:Emboss.IsEmbossed" Value="True"/>
        <Setter Property="controls:Emboss.Status" Value="Normal"/>

        <Setter Property="Background" Value="#ff9800"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="30,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EmbossControlTemplate}"/>
        
        <!-- ステータス連動（疑似クラス） -->
        <Style Selector="^:normal">
            <Setter Property="Background" Value="#ff9800"/>
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="#4caf50"/>
        </Style>
        <Style Selector="^:error">
            <Setter Property="Background" Value="#f44336"/>
        </Style>
        <Style Selector="^:status-disabled">
            <Setter Property="Background" Value="#9e9e9e"/>
        </Style>
        
        <!-- マウスオーバー・クリック時の挙動 -->
        <Style Selector="^:pointerover /template/ Border#PART_InternalBorder">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="translate(1px, 1px)"/>
        </Style>
    </ControlTheme>

    <!-- トグルボタンテーマ（継承） -->
    <ControlTheme x:Key="EmbossToggleButtonTheme" TargetType="ToggleButton" BasedOn="{StaticResource EmbossButtonTheme}">
        <Style Selector="^:checked">
            <Setter Property="Background" Value="#4caf50"/>
        </Style>
        <Style Selector="^:unchecked">
            <Setter Property="Background" Value="#ff9800"/>
        </Style>
    </ControlTheme>

    <!-- ラジオボタンテーマ（継承） -->
    <ControlTheme x:Key="EmbossRadioButtonTheme" TargetType="RadioButton" BasedOn="{StaticResource EmbossButtonTheme}">
        <Style Selector="^:checked">
            <Setter Property="Background" Value="#4caf50"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>
