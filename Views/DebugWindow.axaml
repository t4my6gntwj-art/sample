<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaDiApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        Width="400" Height="300"
        x:Class="AvaloniaDiApp.Views.DebugWindow"
        x:DataType="vm:DebugWindowViewModel"
        Title="DebugWindow">

    <Design.DataContext>
        <vm:DebugWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="デバッグコントロール" FontSize="18" FontWeight="Bold"/>
        
        <Separator Height="10" Opacity="0" />
        
        <TextBlock Text="🔋 電池シミュレーション (1s毎に-5%)" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="100%にリセット" Command="{Binding ResetBatteryCommand}" />
        </StackPanel>

        <Separator Height="20" Opacity="0" />

        <TextBlock Text="🚀 複雑な設定シーケンス (A->B->C->D)" FontWeight="Bold" />
        <Button Content="一括設定シーケンスを実行" Command="{Binding RunSetupSequenceCommand}" Classes="accent" />
        
        <Border Background="#2a2a2a" Padding="10" CornerRadius="5">
            <TextBlock Text="{Binding Log}" Foreground="Lime" FontSize="11" FontFamily="Consolas,Monaco,Courier New" TextWrapping="Wrap" />
        </Border>
    </StackPanel>

</Window>
